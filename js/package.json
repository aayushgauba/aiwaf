{
    "name": "aiwaf",
    "version": "1.1.3",
    "description": "AIWAF Web Application Firewall for JavaScript applications and major Node.js frameworks",
    "main": "index.js",
    "files": [
        "index.js",
        "bin/",
        "lib/",
        "geolock/",
        "resources/",
        "utils/",
        "train.js",
        "README.md",
        "LICENSE",
        "NOTICE",
        "licenses/"
    ],
    "bin": {
        "aiwaf": "bin/aiwaf.js"
    },
    "scripts": {
        "retrain": "AIWAF_LOG_PATH=/var/log/nginx/access.log npm run train",
        "train": "node train.js",
        "test": "jest --runInBand",
        "test:coverage": "jest --runInBand --coverage",
        "test:wasm": "jest --runInBand --runTestsByPath test/wasmAdapter.test.js test/wasm-header-config.test.js test/wasm-header-input.test.js test/wasm-retrain-behavior.test.js test/wasm-waf-integration.test.js && node test/wasm-real.js",
        "aiwaf": "node bin/aiwaf.js",
        "perf:wasm": "node test/perf-wasm.js",
        "test:wasm-real": "node test/wasm-real.js",
        "test:native": "node test/native-pipeline-real.js && node test/native-frameworks-real.js",
        "perf:native": "node ../scripts/benchmark_js_pipeline.js"
    },
    "allowScripts": {
        "sqlite3": true
    },
    "dependencies": {
        "@babel/parser": "^7.29.2",
        "aiwaf-wasm": "^0.2.3",
        "express": "^4.21.2",
        "glob": "^13.0.6",
        "knex": "^2.4.2",
        "node-cache": "^5.1.2",
        "redis": "^4.6.5",
        "sqlite3": "^6.0.1"
    },
    "devDependencies": {
        "@babel/plugin-transform-modules-commonjs": "^7.0.0",
        "babel-jest": "^30.5.2",
        "jest": "^30.5.2",
        "supertest": "^7.1.0",
        "fastify": "^5.12.7",
        "@hapi/hapi": "^21.3.12",
        "koa": "^2.15.4",
        "koa-bodyparser": "^4.4.1",
        "@nestjs/common": "^11.1.18",
        "@nestjs/core": "^11.1.18",
        "@nestjs/platform-express": "^11.1.18",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "jest": {
        "globalTeardown": "<rootDir>/test/jest.teardown.js",
        "forceExit": true,
        "coverageProvider": "v8",
        "transform": {
            "^.+\\.m?js$": [
                "babel-jest",
                { "plugins": ["@babel/plugin-transform-modules-commonjs"] }
            ]
        },
        "transformIgnorePatterns": [
            "node_modules[/\\\\](?!(?:.*[/\\\\])?cookie[/\\\\])"
        ],
        "testPathIgnorePatterns": [
            "<rootDir>/test/wasm-adapter-real.test.js"
        ],
        "collectCoverageFrom": [
            "index.js",
            "train.js",
            "lib/**/*.js",
            "utils/**/*.js"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 66,
                "functions": 100,
                "lines": 80,
                "statements": 80
            }
        }
    },
    "optionalDependencies": {
        "maxmind": "^4.3.0"
    },
    "overrides": {
        "qs": "^6.16.0",
        "@istanbuljs/load-nyc-config": {
            "js-yaml": "^4.1.1"
        }
    },
    "keywords": [
        "waf",
        "firewall",
        "security",
        "express",
        "nodejs",
        "middleware",
        "ml"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aiwaf-project/aiwaf.git",
        "directory": "js"
    },
    "author": "Aayush Gauba",
    "license": "Elastic-2.0 AND MIT AND CC-BY-SA-4.0"
}
