{
    "name": "aiwaf",
    "version": "1.1.2",
    "description": "AIWAF Web Application Firewall for JavaScript applications and major Node.js frameworks",
    "main": "index.js",
    "files": [
        "index.js",
        "bin/",
        "lib/",
        "geolock/",
        "resources/",
        "utils/",
        "train.js",
        "README.md",
        "LICENSE",
        "NOTICE",
        "licenses/"
    ],
    "bin": {
        "aiwaf": "bin/aiwaf.js"
    },
    "scripts": {
        "retrain": "AIWAF_LOG_PATH=/var/log/nginx/access.log npm run train",
        "train": "node train.js",
        "test": "jest --runInBand",
        "test:coverage": "jest --runInBand --coverage",
        "test:wasm": "jest --runInBand --runTestsByPath test/wasmAdapter.test.js test/wasm-header-config.test.js test/wasm-header-input.test.js test/wasm-retrain-behavior.test.js test/wasm-waf-integration.test.js && node test/wasm-real.js",
        "aiwaf": "node bin/aiwaf.js",
        "perf:wasm": "node test/perf-wasm.js",
        "test:wasm-real": "node test/wasm-real.js"
    },
    "allowScripts": {
        "sqlite3": true
    },
    "dependencies": {
        "@babel/parser": "^7.29.2",
        "aiwaf-wasm": "^0.2.1",
        "express": "^4.21.2",
        "glob": "^8.1.0",
        "knex": "^2.4.2",
        "node-cache": "^5.1.2",
        "redis": "^4.6.5",
        "sqlite3": "^6.0.1"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "supertest": "^7.1.0",
        "fastify": "^4.29.1",
        "@hapi/hapi": "^21.3.12",
        "koa": "^2.15.4",
        "koa-bodyparser": "^4.4.1",
        "@nestjs/common": "^10.4.2",
        "@nestjs/core": "^10.4.2",
        "@nestjs/platform-express": "^10.4.2",
        "reflect-metadata": "^0.1.14",
        "rxjs": "^7.8.1"
    },
    "jest": {
        "globalTeardown": "<rootDir>/test/jest.teardown.js",
        "forceExit": true,
        "coverageProvider": "v8",
        "testPathIgnorePatterns": [
            "<rootDir>/test/wasm-adapter-real.test.js"
        ],
        "collectCoverageFrom": [
            "index.js",
            "train.js",
            "lib/**/*.js",
            "utils/**/*.js"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 66,
                "functions": 100,
                "lines": 80,
                "statements": 80
            }
        }
    },
    "optionalDependencies": {
        "maxmind": "^4.3.0"
    },
    "overrides": {
        "body-parser": "^1.20.3",
        "qs": "^6.14.1",
        "path-to-regexp": "^0.1.13",
        "brace-expansion": "^1.1.13",
        "minimatch": "^5.1.8",
        "picomatch": "^2.3.2",
        "form-data": "^4.0.4",
        "js-yaml": "^3.14.2",
        "lodash": "^4.17.24",
        "tar-fs": "^2.1.4"
    },
    "keywords": [
        "waf",
        "firewall",
        "security",
        "express",
        "nodejs",
        "middleware",
        "ml"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aiwaf-project/aiwaf.git",
        "directory": "js"
    },
    "author": "Aayush Gauba",
    "license": "Elastic-2.0 AND MIT AND CC-BY-SA-4.0"
}
